{
  "name": "flowers-for-you",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/build-pwa.ts",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:server": "vitest run --project server",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:react": "vitest run --project react",
    "test:e2e": "vitest run --config vitest.browser.config.ts",
    "pwa:icons": "node src/pwa/generate-icons.ts",
    "sound:render": "node src/audio/generate.ts"
  },
  "dependencies": {
    "@ui-sdk/core": "^0.1.0-beta.17",
    "@ui-sdk/react": "^0.1.0-beta.17",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "playwright": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
